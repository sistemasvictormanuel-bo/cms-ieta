APP_NAME="Sistema IETA - Carrera de Estadística"
APP_ENV=production
# Clave criptográfica de Laravel (generar con 'php artisan key:generate --show' o dejar vacía para autogeneración en arranque)
APP_KEY=
APP_DEBUG=false
APP_URL=https://ieta.estadistica.umsa.bo

# Timezone oficial de Bolivia (Obligatorio en Dokploy)
TZ=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de datos PostgreSQL (Servicio 'db' en docker-compose)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db_ieta_2026
DB_USERNAME=postgres
DB_PASSWORD=ingrese_clave_segura_de_bd

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Frontend SPA - URL base de la API REST (/api para dominio unificado o URL completa)
VITE_API_URL=/api

# Configuración SMTP para envío de correos (Reset contraseñas / Avisos)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=correo_institucional@gmail.com
MAIL_PASSWORD=app_password_o_token
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="ieta@estadistica.umsa.bo"
MAIL_FROM_NAME="IETA - UMSA"

VITE_APP_NAME="${APP_NAME}"
